[Defines]
  DEC_SPECIFICATION              = 0x00010005
  PACKAGE_NAME                   = UemuPkg
  PACKAGE_GUID                   = 710560bb-fdfe-421f-94a7-2af48ba8fb10
  PACKAGE_VERSION                = 1.0

# Include/Library/UemuFdtLib.h holds the header-only helpers every UemuPkg
# module uses to read machine configuration from the emulator's device tree.
# It declares no library class because its helpers are static inline and only
# use MdePkg libraries, which each module lists itself.
[Includes]
  Include

